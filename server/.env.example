# Server Port (Render sets this automatically)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI (REQUIRED)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/attendance_erp?retryWrites=true&w=majority

# Netlify Frontend URL for CORS (REQUIRED)
# Example: https://your-site.netlify.app
CLIENT_URL=https://your-site.netlify.app

# JWT Security Keys (REQUIRED)
JWT_SECRET=generate_a_random_32_character_string_for_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=generate_another_random_32_character_string
JWT_REFRESH_EXPIRE=7d

# Cookie Secret (REQUIRED)
COOKIE_SECRET=generate_a_random_secret_cookie_key

# MySQL (OPTIONAL - For Exam Seating features)
# Use either individual credentials or a full connection URI (e.g. from Aiven, PlanetScale, Railway)
# MYSQL_URL=mysql://user:pass@host:3306/exam_hall_management
# Or:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=exam_hall_management
MYSQL_SSL=false

# Email Configuration (SMTP Gmail - Optional for email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# TextBee SMS Configuration (Optional)
TEXTBEE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Demo SMS Mode (Set to true to simulate SMS without calling external APIs)
DEMO_SMS_MODE=true

# Google Gemini API Key (Optional for AI Attendance Risk & Chatbot features)
GEMINI_API_KEY=
